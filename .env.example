NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ── Admin secrets for Convex write mutations ──
#
# Resolution order (each target):
#   Dev:  CONVEX_DEV_ADMIN_SECRET > DEV_SECRET > ADMIN_SECRET
#   Prod: CONVEX_PROD_ADMIN_SECRET > PROD_SECRET > ADMIN_SECRET
#
# Both the CONVEX_*_ADMIN_SECRET and DEV_SECRET/PROD_SECRET names exist
# for convenience (e.g. early users may have used DEV_SECRET/PROD_SECRET).
# Set at least one per deployment.
#
# Each must match the value configured in the Convex dashboard
# (Settings → Environment Variables → ADMIN_SECRET) for that deployment.
# Use a different secret for dev vs prod.
#
# CONVEX_DEV_ADMIN_SECRET=
# CONVEX_PROD_ADMIN_SECRET=
# DEV_SECRET=
# PROD_SECRET=
ADMIN_SECRET=

