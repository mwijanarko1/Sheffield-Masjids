NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ── OpenAI ChatGPT / Codex plugin domain verification ──
# Paste the exact challenge token from the OpenAI Plugins portal.
# Served as plain text at /.well-known/openai-apps-challenge
# OPENAI_APPS_CHALLENGE_TOKEN=

# Optional Chrome WebMCP origin trial (browser tools, separate from /mcp)
# WEBMCP_ORIGIN_TRIAL_TOKEN=

# ── Admin secrets for Convex write mutations ──

#
# Resolution order (each target):
#   Dev:  CONVEX_DEV_ADMIN_SECRET > DEV_SECRET > ADMIN_SECRET
#   Prod: CONVEX_PROD_ADMIN_SECRET > PROD_SECRET > ADMIN_SECRET
#
# Both the CONVEX_*_ADMIN_SECRET and DEV_SECRET/PROD_SECRET names exist
# for convenience (e.g. early users may have used DEV_SECRET/PROD_SECRET).
# Set at least one per deployment.
#
# Each must match the value configured in the Convex dashboard
# (Settings → Environment Variables → ADMIN_SECRET) for that deployment.
# Use a different secret for dev vs prod.
#
# CONVEX_DEV_ADMIN_SECRET=
# CONVEX_PROD_ADMIN_SECRET=
# DEV_SECRET=
# PROD_SECRET=
ADMIN_SECRET=


# ── Masjidly iqamah-change push (set in Convex dashboard env) ──
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_BUNDLE_ID=mikhailspeaks.Masjidly---Official-Masjid-Prayer-Times
# APNS_KEY_P8=
# APNS_PRODUCTION=true
# FCM_PROJECT_ID=
# FCM_CLIENT_EMAIL=
# FCM_PRIVATE_KEY=


# ── API friction reporting (POST /api/feedback) ──
# Set FEEDBACK_INTAKE_SECRET to the same value in Convex and on the Next.js host.
# Everything else is read by the Convex deployment and is optional.
# FEEDBACK_INTAKE_SECRET=
# FEEDBACK_HASH_SALT=
# FEEDBACK_INTAKE_DISABLED=true
# FEEDBACK_RETENTION_DAYS=90
# FEEDBACK_MAX_REPORTS=500
# FEEDBACK_LIMIT_IP_HOUR=2
# FEEDBACK_LIMIT_IP_DAY=5
# FEEDBACK_LIMIT_GLOBAL_MINUTE=10
# FEEDBACK_LIMIT_GLOBAL_DAY=100
