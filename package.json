    "mcp-handler": "2.1.1",
    "moment-hijri": "^3.0.0",
    "next": "^16.4.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "simple-icons": "^16.19.0",
    "tailwind-merge": "^3.5.0",
    "zod": "4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@oxlint/plugins": "1.79.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "adhan": "^4.4.3",
    "autoprefixer": "^10.4.27",
    "eslint": "^10.1.0",
